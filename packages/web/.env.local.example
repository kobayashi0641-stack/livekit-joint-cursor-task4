# --- Local development overrides for the web app ---
# Copy this file to .env.local and fill in the values.

# Token server (Express backend) — default: http://localhost:3001
VITE_TOKEN_SERVER=http://localhost:3001

# Local Supabase (Docker)
# The anon key below is the standard Supabase local-dev demo JWT
# (see https://supabase.com/docs/guides/self-hosting/docker)
# It is NOT a real secret — it only works with the local Docker stack.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# --- OR: Supabase Cloud (recording storage) ---
# To save recordings to a Cloud project instead of local Docker, use the
# project URL + anon/publishable key from the dashboard (Settings → API):
# VITE_SUPABASE_URL=https://<your-project>.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_xxx   # (or the legacy eyJ... anon key)
